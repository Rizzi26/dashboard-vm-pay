# Postgres do Supabase.
#  - worker de ingestão: conexão direta (porta 5432), sessão longa
#  - API web: pooler (porta 6543), melhor para muitas conexões curtas
DATABASE_URL=postgresql://postgres:senha@db.<projeto>.supabase.co:5432/postgres

# Chave de operador DEDICADA à ingestão. O limite de 300 req/min é por token,
# então esta não pode ser a mesma do MCP nem a da API.
VMPAY_INGEST_TOKEN=

# Ambiente da VMpay. Vazio = produção.
VMPAY_BASE=

# Domínio do dashboard na Vercel, separado por vírgula.
CORS_ORIGINS=http://localhost:3000

INGEST_BATCH_SIZE=500
INGEST_MAX_ROWS=50000
